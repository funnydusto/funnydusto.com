---
interface Props {
	title: string;
	description: string;
	accentColor: string;
	cover: string;
	seoCover: string;
}
const { title, description, accentColor, cover, seoCover } = Astro.props;
	
	import { getCollection } from 'astro:content';
	const projects = await getCollection('projects');
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Backend -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

		<!-- General -->
		<title>{title}</title>
		<meta name="description" content={description}/>
		<meta name="generator" content={Astro.generator}/>

		<meta property="og:url" content={Astro.url}>
        <meta property="og:type" content="website">
        <meta property="og:title" content="funnydusto">
        <meta property="og:description" content={description}>
        <meta property="og:image" content={seoCover}>

		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:domain" content="funnydusto.com">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content="funnydusto">
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={seoCover}>
		<meta name="twitter:site" content="@funnydusto">

		<!-- Search-Engine Specific SEO -->
		<!-- Google -->
		<meta name="google" content="nositelinksearchbox">
		<meta name="googlebot" content="notranslate">

	</head>
	<body class="flex flex-col m-6 bg-[#27163D] text-white">
		<header class="flex flex-col gap-6 py-12">
			<div class="relative">
				<div class="p-[1px] absolute top-[1px] left-[1px] right-[1px] bottom-[1px] rounded-[15px] outline outline-1 outline-[#ffffff24] -outline-offset-1"></div>
				<img src={cover} alt="hello" class="outline outline-1 outline-[#00000024] -outline-offset-1 rounded-[16px]"/>
			</div>
			<h1 class="font-light font-brand text-[2rem]">{title}</h1>
		</header>
		<article>
            <slot />
        </article>
		<div style=`background: radial-gradient(150.38% 100% at 50.13% 0%, #${accentColor}50, #${accentColor}00)` class="absolute -m-6 w-screen h-4/5 -z-10">
		</div>
	</body>
</html>