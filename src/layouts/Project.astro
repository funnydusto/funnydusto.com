---
interface Props {
	title: string;
	description: string;
	image: string | undefined;
}

const { title, description, image } = Astro.props;

// let imagePlaceholder = image;

// if (image.length == 0){
// imagePlaceholder = "/seo/image_b.png"
// };

import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
console.log("Coming from Project.astro: " + image)
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Backend -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

		<!-- General -->
		<title>{title}</title>
		<meta name="description" content={description}/>
		<meta name="generator" content={Astro.generator}/>

		<meta property="og:url" content={Astro.url}>
        <meta property="og:type" content="website">
        <meta property="og:title" content="funnydusto">
        <meta property="og:description" content={description}>
        <meta property="og:image" content={image}>

		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:domain" content="funnydusto.com">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content="funnydusto">
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={image}>
		<meta name="twitter:site" content="@funnydusto">

		<!-- Search-Engine Specific SEO -->
		<!-- Google -->
		<meta name="google" content="nositelinksearchbox">
		<meta name="googlebot" content="notranslate">

	</head>
	<body class="flex flex-col m-6 bg-[#27163D] text-white">
        <h1>{title}</h1>
		<article>
            <Image class="w-full" src={image} alt="hello"/>
            <slot />
        </article>
	</body>
</html>