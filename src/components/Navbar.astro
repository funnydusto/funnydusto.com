---
interface Props {
    label: string | 'funnydusto.com';
    leftActionEnabled?: boolean;
    rightActionEnabled?: boolean;
    leftHref: string | '';
}

const { label, leftActionEnabled, rightActionEnabled, leftHref } = Astro.props;
import { Icon } from 'astro-icon/components';
---

<nav class="flex h-[72px] place-content-between z-10 gap-6 p-4 items-center fixed rounded-full bg-[#27163D60] backdrop-blur-md top-6 left-6 right-6">
    <a href={leftHref} class=`${leftActionEnabled === true ? 'visible' : 'hidden'} rounded-full absolute hover:bg-[#ffffff25] p-2`>
        <Icon name="arrow-previous" class="size-6"/>
    </a>
    <p class="absolute text-center font-brand left-20 right-20">{label}</p>
    <button class="rounded-full absolute right-4 hover:bg-[#ffffff25] p-2">
        <Icon name="menu" class=`${rightActionEnabled === true ? 'visible' : 'hidden'} size-6`/>
    </button>
    <div class="-z-[1] select-none absolute top-[1px] left-[1px] right-[1px] bottom-[1px] rounded-full outline outline-1 outline-[#ffffff24] -outline-offset-1"></div>
</nav>