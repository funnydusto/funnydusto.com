---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Work.astro';
import Prose from '../../components/Prose.astro';
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
    const blogEntries = await getCollection('projects');
    return blogEntries.map(entry => ({
        params: { slug: entry.slug }, props: { entry },
    }));
}
// 2. For your template, you can get the entry directly from the prop
const { entry } = Astro.props;
const { Content } = await entry.render();
export const prerender = true;
console.log("This is the content of " + entry.data.title)
---
<h1>{entry.data.title}</h1>
<Layout title={entry.data.title} description={entry.data.title} image={entry.data.image}>
    <Prose>
        <Content />
    </Prose>
</Layout>