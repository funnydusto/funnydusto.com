---
import Layout from '../layouts/Layout.astro'
import { getCollection } from 'astro:content';
const projectsCollection = await getCollection('projects', ({ data }) => { return data.isFeatured === true; });
---

<Layout title="funnydusto.com" description="let's describe something." image="/seo/image_a.png">
    
    <!-- Hero -->
    <header class="flex justify-end flex-col font-brand h-[60vh] bg-hero-splash bg-cover bg-center px-6 py-8">
        <h1 class="font-light text-[2rem]">Heya, I'm Dustin Coia, or funnydusto.</h1>
    </header>

    <!-- Section A -->
    <section class="flex flex-col gap-6 px-6 py-6 md:flex-row">
        {projectsCollection.map(blogPostEntry => (
            <a href={`/projects/${blogPostEntry.slug}`} style={`background-image: url(${blogPostEntry.data.image})`} class={`relative flex flex-col p-4 w-full md:w-auto md:h-1/5 aspect-video bg-cover justify-end border border-[#00000024] rounded-[16px]`}>
                <p class="text-2xl">{blogPostEntry.data.title}</p>
                <div class="p-[1px] absolute top-[1px] left-[1px] right-[1px] bottom-[1px] rounded-[15px] border border-[#ffffff24]">
                </div>
            </a>
        ))}
    </section>
</Layout>