---
import Layout from '../layouts/Layout.astro'
import Widget11 from '../components/Widget11.astro'
import Widget21 from "../components/Widget21.astro"

import { Projects } from "../data/data.ts"
import { Connections } from "../data/data.ts"
import { Skills } from "../data/data.ts"
---

<Layout title="funnydusto.com" description="let's describe something." image="/seo/image_a.png">
    
    <!-- Hero -->
    <header class="flex justify-end flex-col font-brand h-[60vh] bg-hero-splash bg-cover bg-center px-6 py-8">
        <h1 class="font-light text-[2rem]">Heya, I'm Dustin Coia, or funnydusto.</h1>
    </header>

    <!-- Section A -->
    <section class="flex flex-col gap-6 px-6 py-6">
        {Projects.filter(data => data.recent === true).map(data =>(
        <a href={data.url} class={`relative flex flex-col p-4 w-full aspect-video bg-[url(${data.cover})] bg-cover justify-end border border-[#00000024] rounded-[16px]`}>
            <p class="text-2xl">{data.label}</p>
            <div class="p-[1px] absolute top-[1px] left-[1px] right-[1px] bottom-[1px] rounded-[15px] border border-[#ffffff24]">
            </div>
        </a>
        ))}
    </section>
</Layout>