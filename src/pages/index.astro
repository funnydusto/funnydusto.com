---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro';
import { getCollection } from 'astro:content';
const projectsCollection = await getCollection('projects', ({ data }) => { return data.isFeatured === true; });
---

<Layout title="funnydusto.com" description="let's describe something." image="/seo/image_a.png">
    
    <!-- Navigation -->
    <Navbar label='funnydusto.com' leftIcon='arrow-previous' leftHref='' rightIcon='menu' rightHref=''/>

    <!-- Hero -->
    <header class="flex justify-end flex-col font-brand h-[60vh] bg-hero-splash bg-cover bg-center px-6 py-8">
        <h1 class="font-light text-[2rem]">Heya, I'm Dustin Coia, or funnydusto.</h1>
    </header>

    <!-- Section A -->
    <section class="flex flex-col gap-6 px-6 py-6 md:flex-row">
        {projectsCollection.map(entry => (
            <a href={`/projects/${entry.slug}`} style={`background-image: linear-gradient(#${entry.data.accentColor}00 50%, #${entry.data.accentColor}80), url(${entry.data.image.src})`} class={`relative flex flex-col p-4 overflow-hidden w-full md:w-auto md:h-48 aspect-video bg-cover justify-end outline outline-1 outline-[#00000024] -outline-offset-1 rounded-[16px]`}>
                <p class="text-xl z-[1]">{entry.data.title}</p>
                <div class="z-[1] p-[1px] select-none absolute top-[1px] left-[1px] right-[1px] bottom-[1px] rounded-[15px] outline outline-1 outline-[#ffffff24] -outline-offset-1">
                </div>
                <img src={entry.data.image.src} class="absolute top-0 left-0 -z-[0] transition-all hover:-translate-y-1 hover:translate-x-1 hover:scale-110 hover:blur"/>
            </a>
        ))}
    </section>
</Layout>